{
  "name": "taskflow",
  "version": "1.0.0",
  "description": "Task and Project management system",
  "module": "src/index.ts",
  "type": "module",
  "imports": {
    "#lib/*": {
      "default": "./src/lib/*/index.ts",
      "import": "./src/lib/*/index.ts"
    },
    "#pkg": {
      "default": "./package.json",
      "import": "./package.json"
    },
    "#env": {
      "default": "./src/constants/env.ts",
      "import": "./src/constants/env.ts"
    },
    "#*": {
      "default": "./src/*/index.ts",
      "import": "./src/*/index.ts"
    }
  },
  "scripts": {
    "start": "node src/index.ts",
    "dev": "node --watch src/index.ts"
  },
  "dependencies": {
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": "^24.10.0"
  }
}
